<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nouveau mot de passe — SSIAP Training</title>
<link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--terra:#c25a3a;--terra-d:#a34a2e;--terra-bg:#fdf0eb;--bg:#f7f4f0;--surface:#fff;--border:#e8e2db;--text:#1e1a17;--muted:#8c8078;--subtle:#f0ece7;--green:#2e7d52;--green-bg:#e8f5ee;--red:#c0392b;--red-bg:#fdecea;}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);font-family:'Plus Jakarta Sans',sans-serif;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}
.card{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:44px;max-width:440px;width:100%;box-shadow:0 4px 24px rgba(0,0,0,.07)}
.logo{text-align:center;font-size:44px;margin-bottom:8px}
.title{font-family:'Lora',serif;font-size:24px;font-weight:700;color:var(--text);text-align:center;margin-bottom:6px}
.sub{font-size:13px;color:var(--muted);text-align:center;line-height:1.6;margin-bottom:28px}
.form-group{margin-bottom:16px}
.form-label{display:block;margin-bottom:6px;font-size:11px;font-weight:700;color:var(--text);text-transform:uppercase;letter-spacing:.5px}
.input-wrap{position:relative}
.form-input{width:100%;padding:12px 44px 12px 14px;border:1.5px solid var(--border);border-radius:9px;font-size:14px;font-family:'Plus Jakarta Sans',sans-serif;color:var(--text);outline:none;transition:.15s}
.form-input:focus{border-color:var(--terra);box-shadow:0 0 0 3px var(--terra-bg)}
.pwd-toggle{position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;font-size:16px;color:var(--muted)}
.pwd-toggle:hover{color:var(--terra)}
.strength-bar{height:4px;border-radius:2px;background:var(--subtle);overflow:hidden;margin-top:8px}
.strength-fill{height:100%;border-radius:2px;transition:width .3s,background .3s;width:0}
.strength-label{font-size:10px;color:var(--muted);margin-top:4px}
.btn{width:100%;padding:13px;background:var(--terra);color:#fff;border:none;border-radius:9px;font-family:'Plus Jakarta Sans',sans-serif;font-size:14px;font-weight:700;cursor:pointer;transition:.15s;display:flex;align-items:center;justify-content:center;gap:8px;margin-top:8px}
.btn:hover{background:var(--terra-d)}
.btn:disabled{opacity:.5;cursor:not-allowed}
.alert{padding:12px 14px;border-radius:8px;font-size:13px;margin-bottom:16px;display:none;border:1px solid}
.alert.show{display:block}
.alert.error{background:var(--red-bg);border-color:rgba(192,57,43,.25);color:var(--red)}
.alert.success{background:var(--green-bg);border-color:rgba(46,125,82,.25);color:var(--green)}
.rules{background:var(--subtle);border-radius:8px;padding:12px;margin-bottom:16px;font-size:12px;color:var(--muted);line-height:1.8}
.rule{display:flex;align-items:center;gap:6px}
.rule.ok{color:var(--green)}.rule.ok::before{content:'✓';font-weight:700}
.rule:not(.ok)::before{content:'·'}
.spinner{display:inline-block;width:14px;height:14px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
</style>
</head>
<body>
<div class="card">
  <div class="logo">🔑</div>
  <div class="title">Nouveau mot de passe</div>
  <div class="sub">Choisissez un mot de passe sécurisé pour votre compte.</div>

  <div class="alert" id="alert"></div>

  <div class="rules" id="rules">
    <div class="rule" id="r-len">Au moins 8 caractères</div>
    <div class="rule" id="r-maj">Une lettre majuscule</div>
    <div class="rule" id="r-num">Un chiffre</div>
    <div class="rule" id="r-match">Les deux mots de passe correspondent</div>
  </div>

  <div class="form-group">
    <label class="form-label">Nouveau mot de passe</label>
    <div class="input-wrap">
      <input type="password" class="form-input" id="f-pwd" placeholder="Minimum 8 caractères" oninput="checkRules()">
      <button class="pwd-toggle" type="button" onclick="toggle('f-pwd',this)">👁️</button>
    </div>
    <div class="strength-bar"><div class="strength-fill" id="strength-fill"></div></div>
    <div class="strength-label" id="strength-label"></div>
  </div>

  <div class="form-group">
    <label class="form-label">Confirmer le mot de passe</label>
    <div class="input-wrap">
      <input type="password" class="form-input" id="f-confirm" placeholder="Répétez le mot de passe" oninput="checkRules()">
      <button class="pwd-toggle" type="button" onclick="toggle('f-confirm',this)">👁️</button>
    </div>
  </div>

  <button class="btn" id="btn-submit" onclick="submit()" disabled>
    ✅ Enregistrer le nouveau mot de passe
  </button>
</div>

<script>
const API = window.location.hostname === 'localhost'
  ? 'http://localhost:10000/api'
  : 'https://ssiap-training-center.onrender.com/api';

const resetToken = sessionStorage.getItem('otp_reset_token');
const centerId   = sessionStorage.getItem('otp_center_id');
if (!resetToken || !centerId) window.location.href = 'center-forgot-password.html';

function checkRules() {
  const pwd     = document.getElementById('f-pwd').value;
  const confirm = document.getElementById('f-confirm').value;

  const rules = {
    'r-len':   pwd.length >= 8,
    'r-maj':   /[A-Z]/.test(pwd),
    'r-num':   /[0-9]/.test(pwd),
    'r-match': pwd.length > 0 && pwd === confirm,
  };
  Object.entries(rules).forEach(([id, ok]) => {
    document.getElementById(id).className = ok ? 'rule ok' : 'rule';
  });

  // Force
  let score = 0;
  if (pwd.length >= 8)  score++;
  if (pwd.length >= 12) score++;
  if (/[A-Z]/.test(pwd)) score++;
  if (/[0-9]/.test(pwd)) score++;
  if (/[^A-Za-z0-9]/.test(pwd)) score++;
  const lvls = [
    {w:'20%',bg:'var(--red)',lbl:'Très faible'},
    {w:'40%',bg:'#c25a3a',lbl:'Faible'},
    {w:'60%',bg:'var(--gold,#b8860b)',lbl:'Moyen'},
    {w:'80%',bg:'var(--blue,#2e5c8a)',lbl:'Fort'},
    {w:'100%',bg:'var(--green)',lbl:'Très fort'},
  ];
  const lvl = lvls[Math.min(score,4)];
  document.getElementById('strength-fill').style.cssText = `width:${lvl.w};background:${lvl.bg}`;
  document.getElementById('strength-label').textContent = pwd ? lvl.lbl : '';

  const allOk = Object.values(rules).every(Boolean);
  document.getElementById('btn-submit').disabled = !allOk;
}

async function submit() {
  const pwd = document.getElementById('f-pwd').value;
  const btn = document.getElementById('btn-submit');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner"></span> Enregistrement…';

  try {
    const r = await fetch(`${API}/center/reset-password-otp`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ centerId, resetToken, newPassword: pwd })
    });
    const d = await r.json();

    if (d.success) {
      showAlert('success', '✅ Mot de passe modifié avec succès ! Redirection vers la connexion…');
      // Nettoyer la session
      sessionStorage.removeItem('otp_email');
      sessionStorage.removeItem('otp_reset_token');
      sessionStorage.removeItem('otp_center_id');
      setTimeout(() => { window.location.href = 'center-login.html?reset=1'; }, 2000);
    } else {
      showAlert('error', '⚠️ ' + (d.error || 'Erreur. Le lien a peut-être expiré.'));
      btn.disabled = false;
      btn.innerHTML = '✅ Enregistrer le nouveau mot de passe';
    }
  } catch(e) {
    showAlert('error', '⚠️ Erreur réseau.');
    btn.disabled = false;
    btn.innerHTML = '✅ Enregistrer le nouveau mot de passe';
  }
}

function toggle(id, btn) {
  const el = document.getElementById(id);
  el.type = el.type === 'password' ? 'text' : 'password';
  btn.textContent = el.type === 'password' ? '👁️' : '🙈';
}

function showAlert(type, msg) {
  const el = document.getElementById('alert');
  el.textContent = msg; el.className = `alert ${type} show`;
}
</script>
</body>
</html>
